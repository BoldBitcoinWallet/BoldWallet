# syntax=docker/dockerfile:1
# Dockerfile.fips - BoldWallet FIPS-aware gomobile build (UBI 9 + Android SDK/NDK + Go 1.25)

FROM registry.access.redhat.com/ubi9/ubi:9.4 AS builder

LABEL maintainer="BoldWallet Team" \
      description="FIPS-aware gomobile build env for TSS lib (Android/iOS bindings)" \
      fips="policy-enabled" \
      base="ubi9"

# 1. Install system dependencies
# Added 'curl' which was in your first file but missing in the second
RUN dnf install -y --setopt=install_weak_deps=False --nodocs \
    gcc gcc-c++ make git wget tar unzip which curl \
    java-17-openjdk-devel \
    bzip2 bzip2-devel zlib-devel libffi-devel xz-devel \
    glibc-devel glibc-headers libstdc++-devel \
    crypto-policies openssl openssl-devel \
    && dnf clean all \
    && rm -rf /var/cache/dnf/*

# 2. Enable FIPS crypto policy
RUN update-crypto-policies --set FIPS && \
    grep -q '^FIPS$' /etc/crypto-policies/config || { echo "FIPS policy failed"; exit 1; }

# 3. Install Go 1.25 (FIPS 140-3 enabled by default in Go 1.24+)
ARG GO_VERSION=1.25.0
RUN wget -O go.tar.gz "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" && \
    tar -C /usr/local -xzf go.tar.gz && \
    rm go.tar.gz

# Environment setup combining your preferred paths and FIPS flags
ENV PATH="/usr/local/go/bin:/go/bin:${PATH}" \
    GOPATH="/go" \
    GOCACHE="/go/.cache" \
    GOMODCACHE="/go/pkg/mod" \
    GO111MODULE=on \
    CGO_ENABLED=1 \
    GODEBUG=fips140=on \
    GOFIPS140=v1.0.0

# 4. Android SDK/NDK Setup
# Synced NDK version to 27.1.12297006 from your original file
ENV ANDROID_HOME=/opt/android-sdk \
    ANDROID_SDK_ROOT=/opt/android-sdk \
    ANDROID_NDK_HOME="/opt/android-sdk/ndk/27.1.12297006" \
    PATH="${PATH}:/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools"

RUN mkdir -p ${ANDROID_HOME}/cmdline-tools && \
    wget -q https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip -O cmdline.zip && \
    unzip -q cmdline.zip -d ${ANDROID_HOME}/cmdline-tools && \
    mv ${ANDROID_HOME}/cmdline-tools/cmdline-tools ${ANDROID_HOME}/cmdline-tools/latest && \
    rm cmdline.zip && \
    yes | sdkmanager --licenses >/dev/null 2>&1 && \
    sdkmanager --update && \
    sdkmanager \
        "platform-tools" \
        "platforms;android-34" \
        "build-tools;34.0.0" \
        "ndk;27.1.12297006"

# 5. Gomobile Installation (Pinned Version)
# Using your specific commit hash for gomobile and gobind
RUN go install golang.org/x/mobile/cmd/gomobile@v0.0.0-20250408133729-978277e7eaf7 && \
    go install golang.org/x/mobile/cmd/gobind@v0.0.0-20250408133729-978277e7eaf7 && \
    gomobile init

WORKDIR /BoldWallet/BBMTLib

# 6. Build Command Suggestion (to be run via docker exec or added as a RUN step)
# This uses the 16KB page size flag you added for Android 15 compatibility
# RUN --mount=type=cache,target=/go/pkg/mod \
#     gomobile bind -v -target=android -androidapi 21 \
#     -ldflags="-extldflags=-Wl,-z,max-page-size=16384" \
#     github.com/BoldBitcoinWallet/BBMTLib/tss