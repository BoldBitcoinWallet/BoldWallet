diff --git a/libtss-ffi/src/derive.rs b/libtss-ffi/src/derive.rs
index cd46e9a..f6e6365 100644
--- a/libtss-ffi/src/derive.rs
+++ b/libtss-ffi/src/derive.rs
@@ -58,3 +58,39 @@ pub extern "C" fn tss_derive_path(
         Ok(())
     })
 }
+
+/// Derive along a BIP-32 path using an explicit 32-byte chain code (wallet HD root).
+#[no_mangle]
+pub extern "C" fn tss_derive_path_with_chain_code(
+    key_share: TssHandle,
+    path: *const libc::c_char,
+    chain_code: *const u8,
+    out_handle: *mut TssHandle,
+) -> TssStatus {
+    ffi_entry!({
+        let out = unsafe { out_handle.as_mut() }
+            .ok_or_else(|| libtss::TssError::InvalidConfig("out_handle is null".into()))?;
+        *out = 0;
+
+        if path.is_null() {
+            return Err(libtss::TssError::InvalidConfig("path is null".into()));
+        }
+        if chain_code.is_null() {
+            return Err(libtss::TssError::InvalidConfig("chain_code is null".into()));
+        }
+        let path_str = unsafe { std::ffi::CStr::from_ptr(path) }
+            .to_str()
+            .map_err(|_| libtss::TssError::InvalidConfig("path is not valid UTF-8".into()))?;
+        let mut chain_code_bytes = [0u8; 32];
+        unsafe {
+            std::ptr::copy_nonoverlapping(chain_code, chain_code_bytes.as_mut_ptr(), 32);
+        }
+
+        let handle = borrow_key_share(key_share)?;
+        let derived =
+            libtss::derive_path_with_chain_code(&handle, path_str, chain_code_bytes)?;
+        *out = derived.handle_id();
+        std::mem::forget(derived);
+        Ok(())
+    })
+}
