index d6131ee..212eaa7 100644
--- a/libtss-go/tss/derive.go
+++ b/libtss-go/tss/derive.go
@@ -63,3 +63,31 @@ func DerivePath(keyShare *KeyShareHandle, path string) (*KeyShareHandle, error)
 	}
 	return newKeyShareHandle(out), nil
 }
+
+// DerivePathWithChainCode derives along path using an explicit BIP-32 chain code (wallet HD).
+func DerivePathWithChainCode(keyShare *KeyShareHandle, path string, chainCode []byte) (*KeyShareHandle, error) {
+	if err := checkNonNil("keyShare", keyShare); err != nil {
+		return nil, err
+	}
+	if len(chainCode) != 32 {
+		return nil, fmt.Errorf("chainCode must be 32 bytes, got %d", len(chainCode))
+	}
+	handle, err := keyShare.native.value()
+	if err != nil {
+		return nil, err
+	}
+	if strings.ContainsRune(path, 0) {
+		return nil, fmt.Errorf("path must not contain NUL bytes")
+	}
+	cPath := C.CString(path)
+	defer C.free(unsafe.Pointer(cPath))
+	var out C.TssHandle
+	cc := (*C.uint8_t)(C.CBytes(chainCode))
+	defer C.free(unsafe.Pointer(cc))
+	if err := callStatus(func() C.TssStatus {
+		return C.tss_derive_path_with_chain_code(handle, cPath, cc, &out)
+	}); err != nil {
+		return nil, err
+	}
+	return newKeyShareHandle(out), nil
+}
