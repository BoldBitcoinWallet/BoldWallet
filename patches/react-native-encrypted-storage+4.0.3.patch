+// F4 (patch-package): account name carrying the MPC keyshare blob. Only this
+// entry gets the hardened protection class; other keys keep library behavior.
+static NSString *const kBoldKeyshareAccount = @"keyshare";
+
+// F4: Keychain failures mapped to the stable [SECURE_STORAGE_<KIND>] token
+// the JS layer matches on (see services/secureStorageErrors.ts).
+static void rejectStorage(OSStatus status, NSString *op, RCTPromiseRejectBlock rejecter)
+{
+    NSString *token = @"UNAVAILABLE";
+    if (status == errSecInteractionNotAllowed || status == errSecAuthFailed) {
+        token = @"LOCKED";
+    }
+    NSError* error = [NSError errorWithDomain:[[NSBundle mainBundle] bundleIdentifier] code:status userInfo:nil];
+    NSString* message = [NSString stringWithFormat:@"[SECURE_STORAGE_%@] Keychain %@ failed (OSStatus %d). Your keyshare was not saved/read.", token, op, (int)status];
+    rejectPromise(message, error, rejecter);
+}
