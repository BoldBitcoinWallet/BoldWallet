+                } else if (seq > seqLen) {
+                    novel = uniqueMixSeq.add(seq) || novel;
+                }
+            } catch (NumberFormatException ignored) {
+            }
+        }
+        if (novel) {
+            vibrateOnFrame();
+        }
+        lastScannedText = text;
+        refreshHud();
+        if (novel && (uniqueSeq.size() % 25 == 0 || uniqueMixSeq.size() % 10 == 0)) {
+            Log.i("BoldAirgapScan",
+                "simple=" + uniqueSeq.size() + "/" + seqLen
+                    + " mix=" + uniqueMixSeq.size()
+                    + " payloads=" + uniquePayloads.size());
+        }
+    }
+
+    private void vibrateOnFrame() {
+        if (!hapticOnScan) {
+            return;
+        }
+        long now = SystemClock.elapsedRealtime();
+        if (now - lastHapticAtElapsed < 80) {
+            return;
+        }
+        lastHapticAtElapsed = now;
+        try {
+            Vibrator vibrator;
+            if (Build.VERSION.SDK_INT >= 31) {
+                VibratorManager manager = (VibratorManager) getSystemService(Context.VIBRATOR_MANAGER_SERVICE);
+                vibrator = manager != null ? manager.getDefaultVibrator() : null;
+            } else {
+                vibrator = (Vibrator) getSystemService(Context.VIBRATOR_SERVICE);
+            }
+            if (vibrator == null || !vibrator.hasVibrator()) {
+                return;
+            }
+            if (Build.VERSION.SDK_INT >= 26) {
+                vibrator.vibrate(VibrationEffect.createOneShot(28, VibrationEffect.DEFAULT_AMPLITUDE));
+            } else {
+                vibrator.vibrate(28);
+            }
+        } catch (Exception ignored) {
+        }
+    }
+
+    private void startHudTicker() {
+        if (hudHandler == null) {
+            hudHandler = new Handler(Looper.getMainLooper());
+        }
+        hudHandler.removeCallbacks(hudTick);
+        hudHandler.post(hudTick);
+    }
+
+    private void stopHudTicker() {
+        if (hudHandler != null) {
+            hudHandler.removeCallbacks(hudTick);
+        }
+    }
+
+    private static String formatElapsed(long totalSeconds) {
+        long s = Math.max(0, totalSeconds);
+        if (s < 60) {
+            return s + "s";
+        }
+        long m = s / 60;
+        long rem = s % 60;
+        return m + ":" + (rem < 10 ? "0" : "") + rem;
+    }
+
+    private void refreshHud() {
+        if (progressTextView == null || isFinishing()) {
+            return;
+        }
+        long elapsedSec = 0;
+        if (scanStartedAtElapsed > 0) {
+            elapsedSec = (SystemClock.elapsedRealtime() - scanStartedAtElapsed) / 1000L;
+        }
+        String elapsed = formatElapsed(elapsedSec);
+        StringBuilder line = new StringBuilder();
+        line.append(scanTitle);
+        if (seqLen > 0) {
+            int unique = uniqueSeq.size();
+            int mix = uniqueMixSeq.size();
+            if (unique == 0 && mix == 0 && !uniquePayloads.isEmpty()) {
+                line.append('\n').append("Frames ").append(uniquePayloads.size());
+                line.append(" — keep scanning");
+            } else {
+                int shown = Math.min(unique, Math.max(seqLen - 1, 0));
+                int pct = seqLen > 0 ? Math.min(99, unique * 100 / seqLen) : 0;
+                line.append('\n').append(shown).append(" / ").append(seqLen);
+                line.append(" (").append(pct).append("%)");
+                if (mix > 0) {
+                    line.append('\n').append("Mix ").append(mix).append(" — keep scanning");
+                } else if (unique >= seqLen) {
+                    line.append('\n').append("Keep scanning");
+                }
+            }
+        } else if (!uniquePayloads.isEmpty()) {
+            line.append('\n').append("Frames ").append(uniquePayloads.size());
+        } else {
+            line.append('\n').append("Point camera at the QR");
+        }
+        line.append('\n').append(elapsed);
+        String text = line.toString();
+        progressTextView.setText(text);
+        progressTextView.setVisibility(View.VISIBLE);
+        progressTextView.bringToFront();
+        setCustomStatusMessage(text.replace('\n', ' '));
+    }
+
+    private void setupProgressTextView() {
+        try {
+            if (progressTextView != null) {
+                refreshHud();
+                return;
+            }
+            View rootView = findViewById(android.R.id.content);
+            if (!(rootView instanceof ViewGroup)) {
+                return;
+            }
+            ViewGroup rootGroup = (ViewGroup) rootView;
+
+            progressTextView = new TextView(this);
+            progressTextView.setTextColor(Color.WHITE);
+            progressTextView.setTextSize(TypedValue.COMPLEX_UNIT_SP, 16);
+            progressTextView.setGravity(Gravity.CENTER);
+            progressTextView.setPadding(36, 28, 36, 28);
+            progressTextView.setLineSpacing(0, 1.15f);
+            progressTextView.setMaxLines(5);
+            progressTextView.setBackgroundColor(Color.argb(220, 0, 0, 0));
+            progressTextView.setElevation(24f);
+
+            FrameLayout.LayoutParams params = new FrameLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT,
+                ViewGroup.LayoutParams.WRAP_CONTENT
+            );
+            params.gravity = Gravity.TOP | Gravity.CENTER_HORIZONTAL;
+            int edge = (int) TypedValue.applyDimension(
+                TypedValue.COMPLEX_UNIT_DIP, 16, getResources().getDisplayMetrics()
+            );
+            params.topMargin = (int) TypedValue.applyDimension(
+                TypedValue.COMPLEX_UNIT_DIP, 48, getResources().getDisplayMetrics()
+            );
+            params.leftMargin = edge;
+            params.rightMargin = edge;
+            progressTextView.setLayoutParams(params);
+            rootGroup.addView(progressTextView);
+            refreshHud();
+        } catch (Exception e) {
+            e.printStackTrace();
+        }
+    }
+
+    private DecoratedBarcodeView findBarcodeView(View view) {
+        if (view instanceof DecoratedBarcodeView) {
+            return (DecoratedBarcodeView) view;
+        }
+        if (view instanceof ViewGroup) {
+            ViewGroup group = (ViewGroup) view;
+            for (int i = 0; i < group.getChildCount(); i++) {
+                DecoratedBarcodeView found = findBarcodeView(group.getChildAt(i));
+                if (found != null) {
+                    return found;
+                }
+            }
+        }
+        return null;
+    }
+
+    private void setCustomStatusMessage(String message) {
+        try {
+            View rootView = findViewById(android.R.id.content);
+            if (rootView == null) {
+                return;
+            }
+
+            DecoratedBarcodeView found = findBarcodeView(rootView);
+            if (found == null) {
+                return;
+            }
+
+            ViewGroup barcodeViewGroup = (ViewGroup) found;
+            for (int i = 0; i < barcodeViewGroup.getChildCount(); i++) {
+                View child = barcodeViewGroup.getChildAt(i);
+                if (child.getClass().getName().contains("ViewfinderView")) {
+                    if (child instanceof ViewGroup) {
+                        ViewGroup viewfinderGroup = (ViewGroup) child;
+                        for (int j = 0; j < viewfinderGroup.getChildCount(); j++) {
+                            View viewfinderChild = viewfinderGroup.getChildAt(j);
+                            if (viewfinderChild instanceof TextView) {
+                                ((TextView) viewfinderChild).setText(message);
+                                return;
+                            }
+                        }
+                    }
+                    try {
+                        Field statusViewField = child.getClass().getDeclaredField("statusView");
+                        statusViewField.setAccessible(true);
+                        TextView statusView = (TextView) statusViewField.get(child);
+                        if (statusView != null) {
+                            statusView.setText(message);
+                            return;
+                        }
+                    } catch (NoSuchFieldException e) {
+                    }
+                }
+            }
 
+            TextView statusTextView = findStatusTextView(rootView);
+            if (statusTextView != null) {
+                statusTextView.setText(message);
+            }
+        } catch (Exception e) {
+            e.printStackTrace();
+        }
+    }
 
+    private TextView findStatusTextView(View view) {
+        if (view instanceof TextView) {
+            TextView textView = (TextView) view;
+            String text = textView.getText().toString();
+            if (text.contains("barcode") || text.contains("viewfinder") || text.contains("scan")) {
+                return textView;
+            }
+        }
+        if (view instanceof ViewGroup) {
+            ViewGroup group = (ViewGroup) view;
+            for (int i = 0; i < group.getChildCount(); i++) {
+                TextView found = findStatusTextView(group.getChildAt(i));
+                if (found != null) {
+                    return found;
+                }
+            }
+        }
+        return null;
+    }
 }
