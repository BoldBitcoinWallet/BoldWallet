ms/b75cd3daada5cdb769b0537bc132006e/transformed/jetified-zxing-android-embedded-4.3.0/res/values-zh-rTW/values-zh-rTW.xml" qualifiers="zh-rTW"><string name="zxing_app_name">條碼掃描器</string><string name="zxing_button_ok">確定</string><string name="zxing_msg_camera_framework_bug">很抱歉，Android 相機出現問題，您可能需要重新啟動您的裝置。</string><string name="zxing_msg_default_status">將條碼置於鏡頭範圍內以進行掃描。</string></file><file path="/Users/mac/.gradle/caches/8.13/transforms/b75cd3daada5cdb769b0537bc132006e/transformed/jetified-zxing-android-embedded-4.3.0/res/values-it/values-it.xml" qualifiers="it"><string name="zxing_app_name">Barcode Scanner</string><string name="zxing_button_ok">OK</string><string name="zxing_msg_camera_framework_bug">Spiacenti, la fotocamera Android ha riscontrato un problema. Potrebbe essere necessario riavviare il dispositivo.</string><string name="zxing_msg_default_status">Posiziona un codice a barre dentro il mirino rettangolare per la scansione.</string></file><file path="/Users/mac/.gradle/caches/8.13/transforms/b75cd3daada5cdb769b0537bc132006e/transformed/jetified-zxing-android-embedded-4.3.0/res/values-ca/values-ca.xml" qualifiers="ca"><string name="zxing_app_name">Barcode Scanner</string><string name="zxing_button_ok">D\'acord</string><string name="zxing_msg_camera_framework_bug">S\'ha produït un problema amb la càmera de l\'Android. Potser haureu de reiniciar el dispositiu.</string><string name="zxing_msg_default_status">Poseu un codi de barres dins el rectangle per escanejar-lo.</string></file><file path="/Users/mac/.gradle/caches/8.13/transforms/b75cd3daada5cdb769b0537bc132006e/transformed/jetified-zxing-android-embedded-4.3.0/res/values-cs/values-cs.xml" qualifiers="cs"><string name="zxing_app_name">Barcode Scanner</string><string name="zxing_button_ok">OK</string><string name="zxing_msg_camera_framework_bug">Omlouváme se, zjistili jsem problém s fotoaparátem. Možná bude nutné restartovat zařízení.</string><string name="zxing_msg_default_status">Zaměřte čtvercem na čárový kód</string></file><file path="/Users/mac/.gradle/caches/8.13/transforms/b75cd3daada5cdb769b0537bc132006e/transformed/jetified-zxing-android-embedded-4.3.0/res/values-zh-rCN/values-zh-rCN.xml" qualifiers="zh-rCN"><string name="zxing_app_name">条码扫描器</string><string name="zxing_button_ok">确定</string><string name="zxing_msg_camera_framework_bug">抱歉，Android相机出现问题。您可能需要重启设备。</string><string name="zxing_msg_default_status">请将条码置于取景框内扫描。  </string></file><file path="/Users/mac/.gradle/caches/8.13/transforms/b75cd3daada5cdb769b0537bc132006e/transformed/jetified-zxing-android-embedded-4.3.0/res/values-ja/values-ja.xml" qualifiers="ja"><string name="zxing_app_name">QRコードスキャナー</string><string name="zxing_button_ok">OK</string><string name="zxing_msg_camera_framework_bug">Androidのカメラに問題が発生しました。デバイスを再起動する必要があります。</string><string name="zxing_msg_default_status">QRコードを画面の読み取り範囲内に写すとスキャンします。</string></file><file path="/Users/mac/.gradle/caches/8.13/transforms/b75cd3daada5cdb769b0537bc132006e/transformed/jetified-zxing-android-embedded-4.3.0/res/values-el/values-el.xml" qualifiers="el"><string name="zxing_app_name">Barcode Scanner</string><string name="zxing_button_ok">OK</string><string name="zxing_msg_camera_framework_bug">Συγνώμη, προέκυψε ένα πρόβλημα με την κάμερα. Ίσως χρειαστεί να επανεκιννήσετε τη συσκευή.</string><string name="zxing_msg_default_status">Τοποθετήστε ένα barcode μέσα στο πλαίσιο για να το σκανάρετε.</string></file><file path="/Users/mac/.gradle/caches/8.13/transforms/b75cd3daada5cdb769b0537bc132006e/transformed/jetified-zxing-android-embedded-4.3.0/res/values-da/values-da.xml" qualifiers="da"><string name="zxing_app_name">Barcode Scanner</string><string name="zxing_button_ok">OK</string><string name="zxing_msg_camera_framework_bug">Beklager, Android-kameraet er stødt på et problem. Du skal muligvis genstarte enheden.</string><string name="zxing_msg_default_status">Placér en stregkode inden i firkanten for at aflæse den.</string></file><file name="zxing_c